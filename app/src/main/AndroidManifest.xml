<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.muse.fakecall"
    android:versionCode="16"
    android:versionName="1.0.2">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Tailscale receive-server (:8791) and tailnet-only PC TTS client -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Earpiece / speakerphone / Bluetooth call audio routing -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Incoming / in-call screen: shows over the lock screen, never recreated on rotation -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- External trigger: adb shell am broadcast -a dev.muse.fakecall.TRIGGER -->
        <receiver
            android:name=".TriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.muse.fakecall.TRIGGER" />
            </intent-filter>
        </receiver>

        <!-- Local schedule (AlarmManager) + morning-mode retry -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.muse.fakecall.SCHEDULED_CALL" />
                <action android:name="dev.muse.fakecall.RETRY_CALL" />
            </intent-filter>
        </receiver>

        <!-- Tailscale receive-server (foreground service, port 8791) -->
        <service
            android:name=".CallServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Receives remote fake-call triggers and dialogue replies from Muse over Tailscale" />
        </service>

        <!-- Owns incoming ringing (ringtone/vibration/CallStyle notification) and
             transitions to an ongoing-call CallStyle notification during active calls
             so HyperOS keeps the call alive when the proximity sensor turns the screen off -->
        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rings incoming calls and maintains active call foreground notification" />
        </service>

        <!-- Decline / hangup actions of RingService notifications -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Restart the receive-server and re-arm schedule after reboot or APK update -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
